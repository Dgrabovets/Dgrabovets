# Логин владельца профиля
PROFILE_USER=Dgrabovets
# Папка, куда пишутся SVG
PROFILE_ASSETS_DIR=assets
# Число недель в графике активности
PROFILE_HEATMAP_WEEKS=40
# Папка шрифтов бренда (путь от корня или полный), нужна только scripts/extract_glyphs.py
PROFILE_FONTS_DIR=fonts
# Токен GitHub читается из GITHUB_TOKEN (в Actions выдаётся сам), локально: gh auth token
